          ]
        },
        "moderator": {
          "type": "string",
          "enum": [
            "optional",
            "required"
          ]
        },
        "presale": {
          "type": "string",
          "enum": [
            "optional",
            "required"
          ]
        },
        "presale_head": {
          "type": "string",
          "enum": [
            "optional",
            "required"
          ]
        },
        "security_auditor": {
          "type": "string",
          "enum": [
            "optional",
            "required"
          ]
        },
        "user": {
          "type": "string",
          "enum": [
            "optional",
            "required"
          ]
        }
      },
      "default": {
        "admin": "required",
        "moderator": "required",
        "presale": "required",
        "presale_head": "required",
        "security_auditor": "required",
        "user": "optional"
      },
      "x-spec": [
        "FR-2FA-02",
        "FR-SA-04",
        "Q-23",
        "R-05"
      ],
      "x-owner": "superadmin",
      "x-step-up": true,
      "x-alert": "when a role changes required → optional",
      "x-note": "Для superadmin TOTP всегда обязателен — ключа нет. При нескольких ролях обязателен, если обязателен хотя бы для одной"
    },
    "security.admin_networks": {
      "title": "Разрешённые сети админки суперадминистратора (CIDR)",
      "type": "array",
      "uniqueItems": true,
      "maxItems": 100,
      "items": {
        "type": "string",
        "maxLength": 43,
        "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
