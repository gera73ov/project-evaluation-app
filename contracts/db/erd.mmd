    USERS {
        uuid id PK
        citext login UK
        citext email "partial UK"
        varchar full_name
        user_source source
        uuid ad_object_guid UK
        user_status status
        user_block_reason block_reason
        boolean totp_enabled
    }
    USER_ROLES {
        uuid user_id PK
        system_role role PK
        role_source source
    }
    PASSWORD_HISTORY {
        uuid id PK
        uuid user_id FK
        text password_hash
    }
    BACKUP_CODES {
        uuid id PK
        uuid user_id FK
        text code_hash
        timestamptz used_at
    }
    KNOWN_DEVICES {
        uuid user_id PK
        text ua_family PK
        cidr subnet PK
        timestamptz last_seen_at
    }
    SESSIONS {
        bytea id_hash PK
        uuid user_id FK
        timestamptz expires_at
        boolean mfa_passed
        timestamptz step_up_until
        timestamptz revoked_at
    }
    AUTH_TOKENS {
        uuid id PK
        uuid user_id FK
        auth_token_kind kind
        bytea token_hash UK
        timestamptz expires_at
        timestamptz used_at
    }
    SYSTEM_SETTINGS {
        text key PK
        jsonb value
    }
    PHASES {
        uuid id PK
        varchar name
        int sort_order
        boolean is_cross_cutting "one true"
        boolean is_active
    }
    DISCIPLINES {
        uuid id PK
        varchar name UK
        varchar short_name
        varchar color
        uuid default_profile_id FK
    }
