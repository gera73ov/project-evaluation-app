        uuid id PK
        varchar name
        text icon
        jsonb norms
        boolean is_system "one true"
        uuid project_id FK "NULL = global"
        node_type_proposal proposal_status
        uuid merged_into_id FK
    }
    DISCIPLINE_PROFILES {
        uuid id PK
        uuid discipline_id FK
        varchar name
        uuid_array type_chain
    }
    COMMENT_TAGS {
        uuid id PK
        varchar name
        comment_tag_category category
    }
    CONTROL_RATIOS {
        uuid id PK
        uuid discipline_a_id FK
        uuid_array disciplines_b
        numeric min_pct
        numeric max_pct
    }
    WORK_CALENDAR {
        date date PK
        boolean is_working
        smallint year
    }
    LOSS_REASONS {
        uuid id PK
        varchar name
        boolean is_other
    }
    VAT_RATES {
        uuid id PK
        varchar name
        numeric percent "NULL = no VAT"
        boolean is_default "one true"
    }
    CURRENCIES {
        char code PK
        varchar symbol
        boolean is_active
    }
    PROJECTS {
        uuid id PK
        varchar name
        varchar customer
        project_status status
        project_outcome outcome
        quote_figure quote_figure
        detail_level detail_level
        numeric pm_percent
        bigint version
        int next_question_no
        timestamptz completed_at
    }
    PROJECT_MONEY {
        uuid project_id PK
        char currency FK
        numeric exchange_rate
        uuid vat_rate_id FK
        numeric vat_percent
        numeric contract_amount
    }
    PROJECT_TOTALS {
        uuid project_id PK
        numeric e
        numeric p80
        numeric p90
        numeric cost_rub
        numeric quote_rub
        numeric quote_cur
    }
    PROJECT_TOTALS_DAILY {
        uuid project_id PK
        date date PK
        numeric e
        numeric p80
        numeric p90
    }
