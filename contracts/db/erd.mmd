        uuid id PK
        uuid admin_id FK
        uuid project_id FK
        varchar reason
        timestamptz expires_at
    }
    PROJECT_JOURNAL {
        uuid id PK
        uuid project_id FK
        text action
        boolean is_money
        jsonb changes
    }
