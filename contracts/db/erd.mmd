    }
    MESSAGES {
        uuid id PK
        uuid project_id FK
        uuid node_id FK
        uuid thread_id FK
        uuid author_id FK
        varchar body
        message_kind kind
        boolean needs_answer
    }
    MESSAGE_ADDRESSEES {
        uuid message_id FK
        addressee_type target_type
