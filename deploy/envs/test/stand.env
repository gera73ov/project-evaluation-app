# INF-011 · стенд test (SPEC 18.1): CI, эмуляторы Samba AD, Mailpit, syslog TLS, демо-данные.
# deploy/envs/deploy.sh test переносит эти значения в .env в корне рабочей копии на сервере;
# пароли и ключи в .env генерируются там же и в репозиторий не попадают.
APP_ENV=test
LOG_LEVEL=INFO
# Имя сервера стенда: ссылки в письмах и проверка заголовка Host (SEC-WEB-05)
APP_BASE_URL=https://estimator-test.example.local
TRUSTED_HOSTS=estimator-test.example.local
# Порты наружу: 443 и 80 на всех интерфейсах сервера; кто может подключиться — STAND_NETWORKS
BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80
# Офисная сеть и VPN через пробел (CIDR). Остальным Nginx отвечает 403.
STAND_NETWORKS=10.0.0.0/8 192.168.0.0/16
# Подсеть Docker стенда (не должна пересекаться с сетями компании)
STAND_DOCKER_SUBNET=172.31.250.0/24
# Файлы compose стенда: базовый, эмуляторы корпоративных сервисов, общий файл стендов
COMPOSE_FILES=deploy/compose/docker-compose.yml deploy/compose/docker-compose.test.yml deploy/envs/docker-compose.stand.yml
COMPOSE_PROFILES=test
# Демо-данные (seed-demo): 12 пользователей, «Портал дилеров», проект на 2 000 узлов
STAND_SEED=demo
