# INF-011 · стенд stage (SPEC 18.1): копия prod по составу, корпоративные сервисы настоящие —
# тестовый OU корпоративного AD, почтовый релей, SIEM. Их подключает суперадминистратор в
# мастере первичной настройки (manuals/superadmin.md), эмуляторов здесь нет.
APP_ENV=stage
LOG_LEVEL=INFO
APP_BASE_URL=https://estimator-stage.example.local
TRUSTED_HOSTS=estimator-stage.example.local
BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
HTTP_PORT=80
STAND_NETWORKS=10.0.0.0/8 192.168.0.0/16
# Подсеть Docker стенда (не должна пересекаться с сетями компании)
STAND_DOCKER_SUBNET=172.31.250.0/24
COMPOSE_FILES=deploy/compose/docker-compose.yml deploy/envs/docker-compose.stand.yml
COMPOSE_PROFILES=
# Тестовые проекты (seed-demo; справочники создают миграции). none — без демо-данных.
STAND_SEED=demo
