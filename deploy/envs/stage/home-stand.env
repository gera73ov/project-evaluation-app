# Репетиция stage на домашнем стенде рядом со стендом test (workflow deploy-stage, STAND_ENV_EXTRA).
# Дополняет stand.env: свой проект compose (e2e и deploy-test его не убирают), своя подсеть Docker
# и свои порты на loopback, чтобы не пересекаться со стендом test на той же машине.
COMPOSE_PROJECT_NAME=estimator-stage
STAND_DOCKER_SUBNET=172.31.249.0/24
POSTGRES_PORT=15432
REDIS_PORT=16379
PROMETHEUS_PORT=19090
