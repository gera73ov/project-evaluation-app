# INF-001 · единые правила форматирования для всех редакторов
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.md]
# двойной пробел в конце строки в Markdown значим
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{ps1,bat,cmd}]
end_of_line = crlf
