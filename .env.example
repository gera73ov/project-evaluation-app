# INF-004 · переменные окружения dev-стенда (NFR-MNT-03). Создать .env: `make env`
# (скопирует этот файл и подставит случайные пароли).
# Значения ниже — только для локальной разработки. На stage и prod секреты передаются через
# Docker secrets (SEC-CRYPT-01), а .env в репозиторий не попадает (.gitignore).
# Полная таблица переменных приложения — README.md, раздел «Переменные окружения» (DOC-001);
# её генерирует `estimator config-env`, а тест tests/unit/doc сверяет этот файл с конфигом.

# --- Приложение (backend/src/estimator/config.py) ---
APP_ENV=dev
APP_VERSION=dev
LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Moscow
HEALTH_TIMEOUT_SECONDS=2.0
TRUSTED_HOSTS=*
# SEC-003: мастер-ключ шифрования `<id>:<base64url 32 байта>` (`make env` выпустит случайный;
# вручную — `estimator generate-key`). ENCRYPTION_KEYS_OLD — прежние ключи только на время
# `estimator rotate-key` (SPEC 18.4). На stage и prod — Docker secret encryption_key.
ENCRYPTION_KEY=change-me
ENCRYPTION_KEYS_OLD=
# DATABASE_URL, REDIS_URL, CELERY_BROKER_URL собирает docker-compose.yml из паролей ниже.
# Uvicorn: каким адресам верить в X-Forwarded-For. В dev — любой адрес внутренней сети compose
# (снаружи доступен только Nginx); на stage и prod — адрес Nginx (INF-009, INF-011).
FORWARDED_ALLOW_IPS=*

# --- Пароли сервисов dev-стенда (`make env` заменит на случайные) ---
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis

# --- Эмуляторы профиля test (docker-compose.test.yml) ---
SAMBA_ADMIN_PASSWORD=Change-me-Samba-1
SAMBA_TEST_PASSWORD=Change-me-Test-1
SYSLOG_REQUIRE_CLIENT_CERT=0

# --- Порты на 127.0.0.1 ---
HTTPS_PORT=8443
POSTGRES_PORT=5432
REDIS_PORT=6379
LDAPS_PORT=1636
LDAP_PORT=1389
MAILPIT_UI_PORT=8025
SYSLOG_TLS_PORT=6514
