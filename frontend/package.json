{
  "name": "estimator-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Приложение оценки проектов: SPA (React 18, Vite, TypeScript)",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-build.mjs",
    "preview": "vite preview",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@mantine/core": "7.17.8",
    "@mantine/hooks": "7.17.8",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.21",
    "decimal.js": "10.6.0",
    "i18next": "26.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-security": "4.2.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
